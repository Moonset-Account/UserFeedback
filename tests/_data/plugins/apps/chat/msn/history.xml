        <From>
            <User FriendlyName="morpheus@matrix.internal" />
        </From>
        <To>
            <User FriendlyName="neo@matrix.internal" />
        </To>
        <Text Style="font-family:Comic Sans MS; color:#000000; ">Let me tell you why you are here. You have come because you know something.</Text>
    </Message>

    <Message Date="4/1/2025" Time="1:37:32 PM" DateTime="2025-04-01T13:37Z" SessionID="1">
