    </Message>

    <Message Date="4/1/2025" Time="1:37:18 PM" DateTime="2025-04-01T13:37Z" SessionID="1">
        <From>
            <User FriendlyName="neo@matrix.internal" />
        </From>
        <To>
            <User FriendlyName="morpheus@matrix.internal" />
        </To>
        <Text Style="font-family:Comic Sans MS; color:#000000; ">You're Morpheus. You're a legend. Most hackers would die to meet you.</Text>
    </Message>

    <Message Date="4/1/2025" Time="1:37:20 PM" DateTime="2025-04-01T13:37Z" SessionID="1">
