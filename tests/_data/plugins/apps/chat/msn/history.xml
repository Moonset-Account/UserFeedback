    <Message Date="4/1/2025" Time="1:37:08 PM" DateTime="2025-04-01T13:37Z" SessionID="1">
        <From>
            <User FriendlyName="morpheus@matrix.internal" />
        </From>
        <To>
            <User FriendlyName="neo@matrix.internal" />
