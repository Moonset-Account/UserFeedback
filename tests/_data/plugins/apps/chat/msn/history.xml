    <Message Date="4/1/2025" Time="1:37:14 PM" DateTime="2025-04-01T13:37Z" SessionID="1">
        <From>
            <User FriendlyName="morpheus@matrix.internal" />
        </From>
        <To>
            <User FriendlyName="neo@matrix.internal" />
        </To>
        <Text Style="font-family:Comic Sans MS; color:#000000; ">I can see it in your eyes. You have the look of a man who accepts what he sees because he is expecting to wake up.</Text>
    </Message>

    <Message Date="4/1/2025" Time="1:37:16 PM" DateTime="2025-04-01T13:37Z" SessionID="1">
