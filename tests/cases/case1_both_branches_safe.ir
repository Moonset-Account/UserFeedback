# 验收用例1: 两条分支均满足范围约束
# then 分支由 br 条件直接精化(len <= 64), else 分支补充 check(len <= 128),
# 两条路径上的 alloc/read 长度均可证明有效。
policy max_len 4096
func main @ 1:1
  param len u32 @ 2:1
  const c64 u32 64 @ 3:1
  const c128 u32 128 @ 4:1
  cmp small len ule c64 @ 5:1
  br small L_small L_big @ 6:1
  label L_small
  alloc buf1 len @ 8:1
  read buf1 len @ 9:1
  jmp L_end @ 10:1
  label L_big
  cmp le128 len ule c128 @ 12:1
  check le128 @ 13:1
  alloc buf2 len @ 14:1
  read buf2 len @ 15:1
  jmp L_end @ 16:1
  label L_end
  ret _ @ 18:1
end
