# 07-window-capacity.plan
# Window W1 allows only one change; the second step in the same window
# must be reported as WINDOW_CAPACITY with the involved versions.
service svc-a v1
service svc-b v1

patch P1 svc-a v1 -> v2
patch P2 svc-b v1 -> v2
patch P3 svc-a v2 -> v3

compat svc-a v1 svc-b v1
compat svc-a v2 svc-b v1
compat svc-a v2 svc-b v2
compat svc-a v3 svc-b v2

window W1 capacity=1
window W2 capacity=2

step 1 P1 window=W1
step 2 P2 window=W1
step 3 P3 window=W2

rollback R1 patch=P1
rollback R2 patch=P2
rollback R3 patch=P3

failure F1 after=1 budget=1
