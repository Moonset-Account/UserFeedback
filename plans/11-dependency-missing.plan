# 11-dependency-missing.plan
# P2 is scheduled before its dependency P1 is applied.
# The earliest breach must be DEPENDENCY_MISSING at step 1.
service svc-a v1
service svc-b v1

patch P1 svc-a v1 -> v2
patch P2 svc-b v1 -> v2 deps=P1

compat svc-a v1 svc-b v1
compat svc-a v1 svc-b v2
compat svc-a v2 svc-b v2

window W1 capacity=2

step 1 P2 window=W1
step 2 P1 window=W1

rollback R1 patch=P1
rollback R2 patch=P2

failure F1 after=1 budget=1
