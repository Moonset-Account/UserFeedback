# 04-safe-rollback.plan
# Failure after 3 patches. Every permutation of the three rollback actions
# is compatibility-safe, so the validator must pick the lexicographically
# first shortest sequence deterministically.
service svc-a v1
service svc-b v1
service svc-c v1

patch PA svc-a v1 -> v2
patch PB svc-b v1 -> v2
patch PC svc-c v1 -> v2

# No compat rules: every version combination is unconstrained.

window W1 capacity=3

step 1 PA window=W1
step 2 PB window=W1
step 3 PC window=W1

rollback RA patch=PA
rollback RB patch=PB
rollback RC patch=PC

failure F1 after=3 budget=3
