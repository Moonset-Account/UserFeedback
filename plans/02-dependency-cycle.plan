# 02-dependency-cycle.plan
# Dependency graph contains a cycle -> plan must be rejected pre-flight.
service auth-svc   v1
service order-svc  v1
service pay-svc    v1

patch P1 auth-svc  v1 -> v2 deps=P3
patch P2 order-svc v1 -> v2 deps=P1
patch P3 pay-svc   v1 -> v2 deps=P2

compat auth-svc v1 order-svc v1
compat order-svc v1 pay-svc v1
compat auth-svc v1 pay-svc v1

window W1 capacity=3

step 1 P1 window=W1
step 2 P2 window=W1
step 3 P3 window=W1

rollback R1 patch=P1
rollback R2 patch=P2
rollback R3 patch=P3

failure F1 after=1 budget=1
