{
  "case": "C01",
  "description": "重命名与硬链接按 file_id 追踪；同一派生链（P0->P1->P2）对同一文件的多次写入只计一份受影响文档；两个独立目录满足阈值产生确认发现。",
  "policy": {
    "window_seconds": 60.0,
    "min_documents": 2,
    "min_distinct_dirs": 2,
    "high_entropy_threshold": 7.5,
    "registered_categories": ["document", "office", "pdf"],
    "unknown_category": "unknown",
    "archive_categories": ["archive"],
    "archive_path_suffixes": [".zip", ".tar", ".gz", ".7z", ".rar"]
  },
  "events": [
    {"seq": 1, "ts": 0, "etype": "spawn", "pid": "P1", "ppid": "P0", "gen": 1},
    {"seq": 2, "ts": 1, "etype": "spawn", "pid": "P2", "ppid": "P1", "gen": 2},

    {"seq": 3, "ts": 2, "etype": "open", "file_id": "F1", "path": "/home/u/docs/a.docx", "pid": "P1", "gen": 1},
    {"seq": 4, "ts": 5, "etype": "write", "file_id": "F1", "path": "/home/u/docs/a.docx", "pid": "P1", "gen": 1,
     "pre_category": "document", "post_category": "document", "entropy": {"low": 3.1, "high": 4.0}},
    {"seq": 5, "ts": 10, "etype": "rename", "file_id": "F1", "path": "/home/u/docs/a.docx", "new_path": "/home/u/docs/renamed.docx", "pid": "P1", "gen": 1},
    {"seq": 6, "ts": 12, "etype": "hardlink", "file_id": "F1", "path": "/home/u/docs/renamed.docx", "new_path": "/home/u/links/alias.docx", "pid": "P1", "gen": 1},
    {"seq": 7, "ts": 15, "etype": "write", "file_id": "F1", "path": "/home/u/docs/renamed.docx", "pid": "P2", "gen": 2,
     "pre_category": "unknown", "post_category": "unknown", "entropy": {"low": 7.8, "high": 8.0}},
    {"seq": 8, "ts": 20, "etype": "write", "file_id": "F1", "path": "/home/u/links/alias.docx", "pid": "P1", "gen": 1,
     "pre_category": "unknown", "post_category": "unknown", "entropy": {"low": 7.9, "high": 8.1}},
    {"seq": 9, "ts": 25, "etype": "close", "file_id": "F1", "path": "/home/u/docs/renamed.docx", "pid": "P2", "gen": 2,
     "post_category": "unknown", "entropy": {"low": 7.8, "high": 8.0}},

    {"seq": 10, "ts": 30, "etype": "open", "file_id": "F2", "path": "/home/u/sheets/b.xlsx", "pid": "P2", "gen": 2},
    {"seq": 11, "ts": 35, "etype": "write", "file_id": "F2", "path": "/home/u/sheets/b.xlsx", "pid": "P2", "gen": 2,
     "pre_category": "office", "post_category": "unknown", "entropy": {"low": 7.9, "high": 8.1}},
    {"seq": 12, "ts": 40, "etype": "close", "file_id": "F2", "path": "/home/u/sheets/b.xlsx", "pid": "P2", "gen": 2,
     "post_category": "unknown", "entropy": {"low": 7.9, "high": 8.1}},

    {"seq": 13, "ts": 100, "etype": "watermark"}
  ]
