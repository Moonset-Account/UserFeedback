{
  "namespace": "payments",
  "name": "checkout",
  "defaults": {"runAsUser": 1000},
  "containers": [
    {
      "name": "app",
      "image": "registry.example.com/checkout@sha256:eee555",
      "securityContext": {"privileged": false},
      "volumeMounts": [{"name": "cache", "mountPath": "/cache"}]
    }
  ],
  "initContainers": [
    {
      "name": "migrate",
      "image": "registry.example.com/migrate@sha256:fff666",
      "securityContext": {"runAsUser": 1000}
    }
  ],
  "volumes": [
    {"name": "cache", "hostPath": {"path": "/var/log/readonly-cache/checkout"}}
  ]
}
