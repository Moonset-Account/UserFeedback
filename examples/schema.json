        "internalNote": {"type": "String", "sensitive": true},
        "email": {"type": "String", "sensitive": true},
        "profile": {"type": "Profile"}
      }
    },
    "Org": {
      "kind": "object",
      "interfaces": ["Node"],
      "fields": {
        "id": {"type": "ID"},
        "ownerEmail": {"type": "String", "sensitive": true},
        "internalNote": {"type": "String", "sensitive": true},
        "leadEmail": {"type": "String", "sensitive": true}
      }
    },
    "Profile": {
      "kind": "object",
      "fields": {
